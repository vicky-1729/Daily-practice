pipeline {

    agent any

    environment {
        course = 'Jenkins'
    }
    // options{
    //     {param.hello}
    // }
    stages {

        stage('Build') {
            steps {
                script {
                    sh """
                        echo "Hello brother"
                        env
                    """
                }
            }
        }

        stage('Configure') {

            steps {
                script {

                    def userInput = input(
                        message: 'Do you want to proceed with deployment?',
                        ok: 'Approve',
                        parameters: [
                            string(
                                name: 'USR',
                                defaultValue: '',
                                description: 'Enter your name'
                            )
                        ]
                    )

                    echo "Approval received from: ${userInput}"
                    echo 'All is well'
                }
            }
        }
        stage('Test') {
            steps {
                echo 'Testing is good'
            }
        }
    }

    post {

        always {
            echo 'Pipeline execution completed. Check the status below.'
        }

        success {
            echo 'Pipeline was successful.'
        }

        failure {
            echo 'Pipeline failed.'
        }
    }
}